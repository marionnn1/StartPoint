# =========================
# Variables de entorno (Seguridad)
# =========================
.env
.env.local
.env.*
backend/.env
frontend/.env

# =========================
# Dependencias (Ignorar carpetas pesadas)
# =========================
node_modules/
frontend/node_modules/
backend/node_modules/

# =========================
# Frontend (Vue / Vite)
# =========================
frontend/dist/
frontend/build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Backend (Node.js / Express)
# =========================
# Si usas logs o bases de datos locales
backend/logs/
*.log
backend/*.db
backend/*.sqlite

# Por si acaso decides usar Python en el futuro (de tu anterior proyecto)
__pycache__/
*.py[cod]
.venv/
venv/
backend/venv/

# =========================
# Entornos e IDE (VS Code / Sistema)
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln